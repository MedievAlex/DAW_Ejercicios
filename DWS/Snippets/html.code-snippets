// --------------------------------------------ESTRUCTURA
	"HTML Structure": {
		"scope": "html, php",
		"prefix": "html",
		"body": [
			"<!DOCTYPE html>",
			"<html>",
			"<head>",
			"<meta charset='UTF-8'",
			"</head>",
			"<body>",
			"$0",
			"</body>",
			"</html>"
		],
		"description": "Estructura basica HTML"
 	},

// --------------------------------------------TITULOS
	"HTML H1": {
		"scope": "html, php",
		"prefix": "htmlh1",
		"body": [
			"<h1>${1:titulo}</h1>"
		],
		"description": "Crea un título H1"
	},

	"HTML H2": {
		"scope": "html, php",
		"prefix": "htmlh2",
		"body": [
			"<h2>${1:titulo}</h2>"
		],
		"description": "Crea un título H2"
	},

// --------------------------------------------ELEMENTOS
	"HTML Paragrafo": {
		"scope": "html, php",
		"prefix": "htmlp",
		"body": [
			"<p>${1:paragrafo}</p>"
		],
		"description": "Crea un parágrafo"
	},

	"HTML Image": {
		"scope": "html, php",
		"prefix": "htmlimage",
		"body": [
			"<img src=\"${1:direccion}\" alt=\"${2:descripcion}\">"
		],
		"description": "Crea un enlace"
	},

	"HTML Link": {
		"scope": "html, php",
		"prefix": "htmllink",
		"body": [
			"<a href=\"${1:enlace}\">${2:texto}</a>"
		],
		"description": "Crea un enlace"
	},

// --------------------------------------------LISTAS Y TABLAS
	"HTML List": {
		"scope": "html, php",
		"prefix": "htmllist",
		"body": [
			"<ol>",
			"<li>${1:elemento 1}</li>",
			"<li>${2:elemento 2}</li>",
			"<li>${3:elemento 3}</li>",
			"</ol>"
		],
		"description": "Crea una lista no ordenada"
	},

	"HTML Ordered List": {
		"scope": "html, php",
		"prefix": "htmllistor",
		"body": [
			"<ol>",
			"<li>${1:elemento 1}</li>",
			"<li>${2:elemento 2}</li>",
			"<li>${3:elemento 3}</li>",
			"</ol>"
		],
		"description": "Crea una lista no ordenada"
	},

// --------------------------------------------FORMULARIOS
	"HTML Form": {
		"scope": "html, php",
		"prefix": "htmlform",
		"body": [
			"<form action=\"$1\" method=\"${2:POST}\">",
			"\t$0",
			"</form>"
		],
		"description": "Crea un formulario"
	},

	"HTML Input": {
		"scope": "html, php",
		"prefix": "htmlinput",
		"body": [
			"<label for=\"$1\">$2</label>",
			"<input type=\"${3:text}\" id=\"$1\" name=\"$1\">"
		],
		"description": "Crea un campo de formulario" 
	},

// --------------------------------------------BOTONES
	"HTML Botton": {
		"scope": "html, php",
		"prefix": "htmlbutton",
		"body": [
			"<button type=\"button\">${1:texto}</button>"
		],
		"description": "Crea un botón"
	}

}