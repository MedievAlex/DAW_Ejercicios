// --------------------------------------------ESTRUCTURA
	"PHP Structure": {
		"scope": "php,html",
		"prefix": "php",
		"body": [
			"<?php",
			"$0",
			"?>"
		],
		"description": "Estructura basica PHP"
 	},

// --------------------------------------------ELEMENTOS
	"PHP Variable": {
		"scope": "php,html",
		"prefix": "phpvar",
		"body": [
			"$${1:variable} = $2;"
		],
		"description": "Crea una variable" 
	},

	"PHP Echo": {
		"scope": "php,html",
		"prefix": "phpecho",
		"body": [
			"echo($${1:valor});"
		],
 		"description": "Crea un echo"
	},

// --------------------------------------------CONDICIONALES
	"PHP If": {
		"scope": "php,html",
		"prefix": "phpif",
		"body": [
			"if (${1:condicion}) {",
			"\t$0",
			"}"
		],
		"description": "Crea una estructura if" 
	},

	"PHP If Else": {
		"scope": "php,html",
		"prefix": "phpifelse",
		"body": [
			"if (${1:condicion}) {",
			"\t$1",
			"} else {",
			"\t$2",
			"}"
		],
		"description": "Crea una estructura if con else" 
	},

	"PHP If Else If": {
		"scope": "php,html",
		"prefix": "phpifelseif",
		"body": [
			"if (${1:condicion}) {",
			"\t$1",
			"} elseif(${2:condicion}) {",
			"\t$2",
			"}"
		],
		"description": "Crea una estructura if con else if" 
	},

// --------------------------------------------BUCLES
	"PHP For": {
		"scope": "php,html",
		"prefix": "phpfor",
		"body": [
			"foreach ($$i = ${1:valor}; ${2:condicion}; $$i++) {",
			"\t$3",
			"}"
		],
		"description": "Crea un for" 
	},

	"PHP Foreach": {
		"scope": "php,html",
		"prefix": "phpforeach",
		"body": [
			"foreach ($${1:array} as $${2:elemento}) {",
			"\t$0",
			"}"
		],
		"description": "Crea un foreach" 
	},

	"PHP Function": {
		"scope": "php",
		"prefix": "phpfunction",
		"body": [
			"function ${1:nombre}(${2:parametros}) {",
			"\t$0",
			"}"
		],
		"description": "Crea una función" 
	},

	"PHP POST": {
		"scope": "php",
		"prefix": "phppost",
		"body": [
			"$${1:variable} = $_POST['${2:nombre}'];"
		],
		"description": "Obtiene un valor mediante POST" 
	}

}